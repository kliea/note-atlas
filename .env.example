OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
EMBED_MODEL=all-MiniLM-L6-v2
DB_PATH=./data/notes.db
GROBID_URL=http://127.0.0.1:8070
GROBID_IMAGE=grobid/grobid:0.9.1-crf
GROBID_AUTOSTART=1
OPENALEX_API_KEY=
S2_API_KEY=
CROSSREF_MAILTO=

# Files pipeline (lab RAG): uploads directory and fixed-size chunking.
FILES_DIR=./data/files
FILES_CHUNK_SIZE=500
FILES_CHUNK_OVERLAP=0
FILES_CHROMA_PATH=./data/chroma_files
FILES_EMBED_MODEL=nomic-embed-text
FILES_EMBED_BATCH=32
FILES_LLM_MODEL=phi3
FILES_TOP_K=3
# Blank = off (lab-faithful). A cosine similarity such as 0.35 refuses without calling the model.
FILES_SCORE_THRESHOLD=
# Lab enhancement activities (each independently switchable; 1 = on, 0 = off).
FILES_DOCX=1
FILES_TXT_FALLBACK=1
FILES_SHOW_SOURCES=1
FILES_HYBRID=0
FILES_MEMORY_TURNS=0
FILES_MODEL_PICKER=1
